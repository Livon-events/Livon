# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin (production: https://livon.live)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — transactional email (event reminders, etc.)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Livon <onboarding@resend.dev>

# Protects /api/cron/* routes (local curl + Vercel Cron)
CRON_SECRET=
